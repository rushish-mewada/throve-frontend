# THROVE Storefront — Environment Template (.env.example)
# Copy to .env.local for development, or configure in deployment platform for production.

# Storefront Backend Connection (Server-side only — never use NEXT_PUBLIC_)
STOREFRONT_API_URL=http://127.0.0.1:3002
STOREFRONT_PUBLISHABLE_KEY=pk_live_throve_01
STOREFRONT_SECRET_KEY=sk_live_throve_01
REVALIDATE_SECRET=whsec_throve_reval_live_01

# Public Storefront URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cashfree One-Click Checkout (Server-side credentials)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
APP_ID=
SECRET_KEY=

# Virtual Try-On
DECART_API_KEY=
NEXT_TELEMETRY_DISABLED=1
